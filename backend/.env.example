# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
MONGO_URI=mongodb://localhost:27017/api-monitor

# Detection thresholds (ms)
THRESHOLD_RESPONSE_WARN_MS=3000
THRESHOLD_RESPONSE_CRIT_MS=5000

# LLM (filled in Phase 3)
LLM_PROVIDER=openai
LLM_API_KEY=[REDACTED]
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=5000
LLM_CONCURRENCY=5

# CORS (comma-separated origins; * for all)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email (optional, Phase 4)
EMAIL_ENABLED=false
