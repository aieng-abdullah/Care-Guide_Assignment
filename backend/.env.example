# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
MONGO_URI=mongodb://localhost:27017/api-monitor

# Detection thresholds (ms)
THRESHOLD_RESPONSE_WARN_MS=3000
THRESHOLD_RESPONSE_CRIT_MS=5000

# LLM (OpenRouter free models — key from https://openrouter.ai/keys)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-[REDACTED]
LLM_MODEL=minimax/minimax-m3.1-flash:free
LLM_TIMEOUT_MS=10000
LLM_CONCURRENCY=5

# CORS (comma-separated origins; * for all)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email (optional, Phase 4)
EMAIL_ENABLED=false
